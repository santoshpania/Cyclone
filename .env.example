# ── Backend (backend/.env) ───────────────────────────────────────────────
ENVIRONMENT=development
# App connects as app_backend (RLS enforced). Migrations connect as the schema owner.
DATABASE_URL=postgresql://app_backend:change-me@localhost:5432/cyclone
MIGRATIONS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyclone
APP_DB_PASSWORD=change-me
# Supabase transaction pooler (port 6543) needs this:
DB_DISABLE_PREPARED_STATEMENTS=false

# Auth: Supabase project URL (JWKS) and/or legacy JWT secret
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Local only: accept "Authorization: Dev <uuid>". Refused in production.
AUTH_DEV_BYPASS=false

# Uploads: local | supabase (service-role key is used for Storage only, never the DB)
STORAGE_BACKEND=local
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=imports

# AI + geocoding (all optional; features degrade gracefully without them)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
LLM_SEND_SAMPLE_VALUES=true
OPENCAGE_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GEOCODE_COUNTRY_CODES=ae

RUN_TASKS_INLINE=false

# ── Web (web/.env.local) ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# dev = local sign-in without Supabase (pairs with AUTH_DEV_BYPASS=true)
NEXT_PUBLIC_AUTH_MODE=supabase
